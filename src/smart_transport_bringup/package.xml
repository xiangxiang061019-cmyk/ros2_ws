<?xml version="1.0"?>
<package format="3">
  <name>smart_transport_bringup</name>
  <version>0.1.0</version>
  <description>Launch and parameter entry points for the transport robot.</description>
  <maintainer email="robot@example.invalid">smart transport team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>smart_transport_description</exec_depend>
  <exec_depend>smart_transport_hardware</exec_depend>
  <exec_depend>smart_transport_perception</exec_depend>
  <exec_depend>smart_transport_task</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
