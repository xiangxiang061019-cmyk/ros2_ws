<?xml version="1.0"?>
<robot name="smart_transport">
  <link name="base_link"/>
  <link name="lidar_link"/>
  <link name="qr_camera_link"/>
  <link name="grasp_camera_link"/>
  <link name="ops9_link"/>

  <!-- Replace these zero extrinsics with measured values after calibration. -->
  <joint name="base_to_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="base_to_qr_camera" type="fixed">
    <parent link="base_link"/>
    <child link="qr_camera_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="base_to_grasp_camera" type="fixed">
    <parent link="base_link"/>
    <child link="grasp_camera_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="base_to_ops9" type="fixed">
    <parent link="base_link"/>
    <child link="ops9_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
